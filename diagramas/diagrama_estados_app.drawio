<mxfile host="app.diagrams.net">
  <diagram name="Estados - Navegacion" id="estados-navegacion">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Pseudo-estado inicial -->
        <mxCell id="n_init" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="30" y="220" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Estados -->
        <mxCell id="n_login" value="LOGIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="110" y="200" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_registro" value="REGISTRO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="110" y="340" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_home" value="HOME" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="340" y="200" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_detalle" value="DETALLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="580" y="120" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_perfil" value="PERFIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="580" y="280" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Transiciones -->
        <mxCell id="t0" style="html=1;endArrow=block;" edge="1" parent="1" source="n_init" target="n_login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="login exitoso" style="html=1;endArrow=block;" edge="1" parent="1" source="n_login" target="n_home">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="ir a registro" style="html=1;endArrow=block;" edge="1" parent="1" source="n_login" target="n_registro">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="registro exitoso" style="html=1;endArrow=block;" edge="1" parent="1" source="n_registro" target="n_home">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="volver" style="html=1;endArrow=block;" edge="1" parent="1" source="n_registro" target="n_login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="abrir paciente" style="html=1;endArrow=block;" edge="1" parent="1" source="n_home" target="n_detalle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="volver" style="html=1;endArrow=block;" edge="1" parent="1" source="n_detalle" target="n_home">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="abrir perfil" style="html=1;endArrow=block;" edge="1" parent="1" source="n_home" target="n_perfil">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="volver" style="html=1;endArrow=block;" edge="1" parent="1" source="n_perfil" target="n_home">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="cerrar sesión" style="html=1;endArrow=block;" edge="1" parent="1" source="n_perfil" target="n_login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Estados - Alerta critica" id="estados-alerta">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Pseudo-estado inicial -->
        <mxCell id="a_init" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="30" y="200" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Estados -->
        <mxCell id="a_normal" value="Normal&#10;(esCritico = false)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="110" y="170" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a_critico" value="Crítico — alerta visible&#10;(esCritico=true, alertaCerrada=false)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a_cerrada" value="Crítico — alerta oculta&#10;(esCritico=true, alertaCerrada=true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="420" y="280" width="260" height="90" as="geometry" />
        </mxCell>

        <!-- Transiciones -->
        <mxCell id="b0" style="html=1;endArrow=block;" edge="1" parent="1" source="a_init" target="a_normal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="algún signo = 3 puntos&#10;o NEWS-2 total &gt;= 7" style="html=1;endArrow=block;" edge="1" parent="1" source="a_normal" target="a_critico">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="doctor presiona ACEPTAR" style="html=1;endArrow=block;" edge="1" parent="1" source="a_critico" target="a_cerrada">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="sigue crítico&#10;(la alerta no se reabre)" style="html=1;endArrow=block;" edge="1" parent="1" source="a_cerrada" target="a_cerrada">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="300" />
              <mxPoint x="760" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="b4" value="paciente se estabiliza&#10;(se re-arma alertaCerrada=false)" style="html=1;endArrow=block;" edge="1" parent="1" source="a_cerrada" target="a_normal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
